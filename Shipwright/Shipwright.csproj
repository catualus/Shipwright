<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows, and not by accident. This drives gmad and gmpublish, reads a Source engine BSP and
      asks the Steam client on this machine what state it is in - the last of which needs the
      registry, which is in-box on this framework and a package on the portable one.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>

    <!--
      Shipwright.Core, not Shipwright: the executable produced by ShipwrightCli is called
      shipwright, and NuGet compares the two names case-insensitively when it builds the restore
      graph - two of them is an ambiguous project name and nothing restores at all. The namespace
      stays Shipwright, which is what the code is written against.
    -->
    <AssemblyName>Shipwright.Core</AssemblyName>
    <RootNamespace>Shipwright</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Log.Neutralise is internal because nothing outside this assembly should be choosing whether to
    filter a line - everything printed goes through Log. The test for it is the reason this is here:
    what it does is a safety property, and widening the method to public so a test could reach it
    would be shaping the API around the tests.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Shipwright.Tests" />
  </ItemGroup>

</Project>
