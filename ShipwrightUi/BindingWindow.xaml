<Window x:Class="Shipwright.Ui.BindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workshop target" Height="760" Width="620"
        MinHeight="620" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Icon="shipwright.ico"
        Background="{DynamicResource Ground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Which map this is about. Named first, because the whole point of this window is that the
         answer belongs to one map rather than to the preset. -->
    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Heading}" Text="Workshop target"/>
      <TextBlock x:Name="MapNameText" Style="{StaticResource Soft}" Margin="0,2,0,0"/>
    </StackPanel>

    <!-- What this map is, and what it is pointed at. Everything here is read from the compiled BSP
         and the state file beside the map - the same inspection the compile step does, shown at the
         point where the decisions about it are made rather than in a log afterwards. -->
    <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="6" Padding="12"
            Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <StackPanel>
        <TextBlock Style="{StaticResource Soft}" Text="Bound to"/>
        <TextBlock x:Name="BoundTitleText" Margin="0,3,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="BoundDetailText" Style="{StaticResource Soft}" Margin="0,2,0,0"/>

        <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,10"/>

        <TextBlock x:Name="BspFactsText" Style="{StaticResource Soft}"/>
        <TextBlock x:Name="LumpFactsText" Style="{StaticResource Soft}" Margin="0,3,0,0"/>
        <TextBlock x:Name="ExtrasFactsText" Style="{StaticResource Soft}" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="2" Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                SelectionChanged="Tabs_SelectionChanged">

      <TabItem Header="Publishing">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>

            <CheckBox x:Name="PublishBox" Click="PublishBox_Click" FontWeight="SemiBold"
                      Content="Publish this map when it compiles"/>
            <TextBlock Style="{StaticResource Soft}" Margin="22,0,0,0" TextWrapping="Wrap"
                       Text="Off, and every compile is a dry run: the addon is built and reported, and nothing is uploaded. This is per map - other maps in the queue are unaffected."/>

            <CheckBox x:Name="AllowCreateBox" Click="PublishBox_Click" Margin="0,12,0,0"
                      Content="Create a Workshop item if this map is not bound to one"/>
            <TextBlock Style="{StaticResource Soft}" Margin="22,0,0,0" TextWrapping="Wrap"
                       Text="Uses the title, tags and icon on the New item tab. Without this, a map with no item is left alone."/>

            <TextBlock x:Name="PlanText" Margin="0,14,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>

            <TextBlock Style="{StaticResource Soft}" Margin="0,16,0,3" Text="Change note for the next update"/>
            <TextBox x:Name="ChangeNoteBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52"
                     VerticalScrollBarVisibility="Auto" LostFocus="ChangeNoteBox_LostFocus"/>
            <TextBlock Style="{StaticResource Soft}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="Shown on the item's changelog. Reduced to plain US-ASCII, which is what gmpublish accepts."/>

            <TextBlock Style="{StaticResource Soft}" Margin="0,16,0,3" Text="Ship beside the map"/>
            <CheckBox x:Name="IncludeLumpBox" Click="PublishBox_Click" Content="Entity lump (.lmp)"/>
            <TextBlock Style="{StaticResource Soft}" Margin="22,0,0,6" TextWrapping="Wrap"
                       Text="Off is the point of the tool: subscribers get a map with no entities to decompile, and the server they join sends them the entities. On makes the published map playable on its own."/>
            <CheckBox x:Name="IncludeNavBox" Click="PublishBox_Click" Content="Nav mesh (.nav)"/>
            <CheckBox x:Name="IncludeAinBox" Click="PublishBox_Click" Content="AI node graph (.ain)"/>

            <TextBlock Style="{StaticResource Soft}" Margin="0,14,0,3" Text="Do not publish this item again within"/>
            <ComboBox x:Name="IntervalBox" Width="150" HorizontalAlignment="Left"
                      SelectionChanged="IntervalBox_SelectionChanged"/>
            <TextBlock Style="{StaticResource Soft}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="Every update makes every subscriber and every server redownload the addon."/>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Your maps" x:Name="MineTab">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Everything this Steam account has published for Garry's Mod."/>

          <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" x:Name="RefreshMineButton" Content="Refresh" Click="RefreshMineButton_Click"/>
            <CheckBox DockPanel.Dock="Right" x:Name="OnlyMapsBox" Content="Only maps" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,12,0" Click="OnlyMapsBox_Click"
                      ToolTip="Filter by the addon type recorded on the Workshop, not by the title"/>
            <TextBlock x:Name="MineMessage" Style="{StaticResource Soft}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          </DockPanel>

          <ListBox Grid.Row="2" x:Name="MineList" Margin="0,10,0,0" BorderThickness="1"
                   Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2,4">
                  <Button DockPanel.Dock="Right" Content="Bind" Tag="{Binding}" Click="BindMineButton_Click"/>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Mono}">
                      <Run Text="{Binding Id, Mode=OneWay}"/><Run Text="{Binding Detail, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Paste a link">
        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="Paste the item's page address, or its ID."/>
          <TextBlock Style="{StaticResource Soft}" Margin="0,2,0,0"
                     Text="Open the item on the Workshop and copy the address bar. Nothing here uploads anything."/>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LinkBox" Grid.Column="0" TextWrapping="NoWrap"/>
            <Button x:Name="LookUpButton" Grid.Column="1" Margin="8,0,0,0" Content="Look up"
                    Click="LookUpButton_Click" IsDefault="True"/>
          </Grid>

          <Border x:Name="ResultPanel" Margin="0,12,0,0" CornerRadius="6" Padding="12" Visibility="Collapsed"
                  Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="72" Height="72" CornerRadius="4" ClipToBounds="True"
                        Background="{DynamicResource Row}">
                  <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="12,0,0,0" Width="360">
                  <TextBlock x:Name="ResultTitleText" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ResultDetailText" Style="{StaticResource Soft}" Margin="0,3,0,0"/>
                  <TextBlock x:Name="ResultCreatorText" Style="{StaticResource Mono}" Margin="0,3,0,0"/>
                </StackPanel>
              </StackPanel>

              <TextBlock x:Name="ResultWarningText" Margin="0,10,0,0" Visibility="Collapsed"
                         Foreground="{DynamicResource Warn}"/>

              <Button x:Name="BindButton" Style="{StaticResource Primary}" Margin="0,12,0,0"
                      HorizontalAlignment="Left" Content="Bind this item" Click="BindButton_Click"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="LookUpMessage" Margin="0,10,0,0" Visibility="Collapsed"
                     Foreground="{DynamicResource Bad}"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="New item">
        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="What the item should be created as."/>
          <TextBlock Style="{StaticResource Soft}" Margin="0,2,0,0"
                     Text="Saved beside the map. The item itself is created by the next compile, if the step is set to publish and allowed to create."/>

          <TextBlock Style="{StaticResource Soft}" Margin="0,14,0,3" Text="Title"/>
          <TextBox x:Name="TitleBox"/>

          <TextBlock Style="{StaticResource Soft}" Margin="0,14,0,3" Text="Tags — up to two"/>
          <WrapPanel x:Name="TagPanel"/>

          <TextBlock Style="{StaticResource Soft}" Margin="0,10,0,3" Text="Icon — 512x512 baseline JPEG"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IconBox" Grid.Column="0" TextWrapping="NoWrap" IsReadOnly="True"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Choose…" Click="ChooseIconButton_Click"/>
          </Grid>
          <TextBlock x:Name="IconVerdictText" Margin="0,8,0,0" Style="{StaticResource Soft}"/>

          <Button x:Name="SaveNewButton" Style="{StaticResource Primary}" Margin="0,16,0,0"
                  HorizontalAlignment="Left" Content="Save" Click="SaveNewButton_Click"/>
        </StackPanel>
      </TabItem>

    </TabControl>

    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Click="CloseButton_Click" IsCancel="True"/>
      <Button x:Name="UnbindButton" DockPanel.Dock="Right" Margin="0,0,8,0"
              Content="Remove binding" Click="UnbindButton_Click"/>
      <TextBlock x:Name="StatusText" Style="{StaticResource Soft}" VerticalAlignment="Center"/>
    </DockPanel>

  </Grid>
</Window>
